  m_Name: "20-2_\uD3EC\uC158_\uD68C\uC218"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uD734, \uBCF4\uBCF4\uB9C8\uC744\uB85C \uB3CC\uC544\uC654\uB124\uC694!
      \uC4F0\uB7EC\uC9C4 \uC790\uB9AC\uC5D0 \uC544\uAE4C \uAC00\uC9C0\uACE0 \uC788\uB358
      \uD3EC\uC158\uC774 \uB0A8\uC544 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uD654\uC0B4\uD45C\uB97C \uB530\uB77C\uAC00\uC11C E\uB85C \uC0C1\uC790\uB97C
      \uC5F4\uC5B4 \uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC0C1\uC790 \uC18D \uD3EC\uC158\uC744 \uD55C \uBC88 \uD074\uB9AD\uD558\uBA74
      \uB0B4 \uC778\uBCA4\uD1A0\uB9AC\uB85C \uB418\uCC3E\uC744 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03

  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "21_\uB530\uB543_\uD3EC\uC158_\uB9C8\uC2DC\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uC81C \uB530\uB543 \uD3EC\uC158\uC744 \uB9C8\uC154 \uCD94\uC704\uB97C
      \uBC97\uC5B4\uB098\uBCFC\uAE4C\uC694?"
    speed: 0.03
  - text: "1\uBC88 \uC2AC\uB86F\uC5D0 \uB530\uB543 \uD3EC\uC158\uC744 \uC900\uBE44\uD574\uB4DC\uB9B4\uAC8C\uC694.
      \uC22B\uC790 1\uC744 \uB20C\uB7EC \uAEBC\uB0B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744 \uAFB9 \uB20C\uB7EC
      \uB9C8\uC2DC\uACE0, \uCCB4\uC628 \uAC8C\uC774\uC9C0\uAC00 \uC62C\uB77C\uAC00\uB294
      \uAC83\uC744 \uD655\uC778\uD574\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uB530\uB543 \uD3EC\uC158\uC740 \uCCB4\uC628\uC744 15 \uC62C\uB824\uC918\uC694.
      \uCD94\uC704\uC5D0\uC11C \uBC97\uC5B4\uB098\uBA74 \uC6D0\uB798 \uCCB4\uC628\uC73C\uB85C
      \uBCF5\uC6D0\uD560\uAC8C\uC694."
    speed: 0.03

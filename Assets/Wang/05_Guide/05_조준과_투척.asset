--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "05_\uC870\uC900\uACFC_\uD22C\uCC99"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uBC88\uC5D0\uB294 \uD3EC\uC158\uC744 \uB9C8\uC2DC\uACE0, \uB358\uC9C0\uACE0,
      \uD45C\uC801\uB3C4 \uBD80\uC234\uBCFC \uAC70\uC608\uC694."
    speed: 0.03
  - text: "\uC870\uC900\uD558\uC9C0 \uC54A\uC740 \uC0C1\uD0DC\uC5D0\uC11C \uB9C8\uC6B0\uC2A4
      \uC67C\uCABD \uBC84\uD2BC\uC744 \uAE38\uAC8C \uB20C\uB7EC \uD3EC\uC158\uC744
      \uB9C8\uC154\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC190\uC774 \uBE44\uC5C8\uB2E4\uBA74 F\uB97C \uB20C\uB7EC \uD3EC\uC158\uC744
      \uB2E4\uC2DC \uAEBC\uB0B4\uC138\uC694."
    speed: 0.03
  - text: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB204\uB974\uACE0
      \uC788\uC73C\uBA74 \uD3EC\uC158\uC774 \uB0A0\uC544\uAC08 \uADA4\uC801\uC774
      \uBCF4\uC5EC\uC694."
    speed: 0.03
  - text: "\uBE5B\uB098\uB294 \uBC14\uC704 \uD45C\uC801\uC5D0 \uADA4\uC801\uC744
      \uB9DE\uCD94\uACE0 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744 \uC9E7\uAC8C
      \uB20C\uB7EC\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC774 \uC5F0\uC2B5\uC6A9 \uD45C\uC801\uC740 \uC5B4\uB5A4 \uD3EC\uC158\uC774\uB4E0
      \uC9C1\uC811 \uB9DE\uD788\uBA74 \uBD80\uC11C\uC838\uC694."
    speed: 0.03
  - text: "\uBE57\uB098\uAC14\uB2E4\uBA74 \uD3EC\uC158\uC744 \uB2E4\uC2DC \uAEBC\uB0B4
      \uB3C4\uC804\uD574\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uB9C8\uC2DC\uAE30, \uB358\uC9C0\uAE30, \uD45C\uC801 \uBD80\uC218\uAE30\uB97C
      \uBAA8\uB450 \uC644\uB8CC\uD558\uBA74 \uB2E4\uC74C\uC73C\uB85C \uB118\uC5B4\uAC08\uAC8C\uC694."
    speed: 0.03

  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "05_\uC870\uC900\uACFC_\uD22C\uCC99"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC190\uC5D0 \uB4E0 \uD3EC\uC158\uC744 \uC800 \uD45C\uC801\uC5D0 \uB358\uC838\uBCFC\uAE4C\uC694?"
    speed: 0.03
  - text: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB204\uB974\uACE0
      \uC788\uC73C\uBA74 \uD3EC\uC158\uC774 \uB0A0\uC544\uAC08 \uADA4\uC801\uC774
      \uBCF4\uC5EC\uC694."
    speed: 0.03
  - text: "\uADA4\uC801\uC744 \uD45C\uC801\uC5D0 \uB9DE\uCD98 \uB2E4\uC74C \uB9C8\uC6B0\uC2A4
      \uC67C\uCABD \uBC84\uD2BC\uC744 \uC9E7\uAC8C \uB20C\uB7EC\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC544\uAE5D\uB2E4\uACE0 \uB108\uBB34 \uC624\uB798 \uB204\uB974\uC9C0\uB294
      \uB9C8\uC138\uC694!"
    speed: 0.03

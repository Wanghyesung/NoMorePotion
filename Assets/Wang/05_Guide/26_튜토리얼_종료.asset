  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "26_\uD29C\uD1A0\uB9AC\uC5BC_\uC885\uB8CC"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC9C0\uC5ED \uBCF4\uC2A4\uAE4C\uC9C0 \uC4F0\uB7EC\uB728\uB838\uB124\uC694!
      \uB9C8\uC9C0\uB9C9 \uC2E4\uC2B5\uB3C4 \uB05D\uB0AC\uC5B4\uC694."
    speed: 0.03
  - text: "\uC774\uC81C \uB0AE\uC5D0\uB294 \uC7AC\uB8CC\uB97C \uBAA8\uC73C\uACE0
      \uD544\uC694\uD55C \uD3EC\uC158\uC744 \uB9CC\uB4E4\uC5B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uBC24\uC774 \uC624\uBA74 \uB9C8\uC744\uB85C \uB3CC\uC544\uC640 \uC218\uC815\uAD6C\uC2AC\uC744
      \uC9C0\uCF1C\uC8FC\uC2DC\uACE0\uC694."
    speed: 0.03
  - text: "\uB2E4\uB978 \uC9C0\uC5ED\uC758 \uBCF4\uC2A4\uB4E4\uB3C4 \uC4F0\uB7EC\uB728\uB824
      \uB9C8\uC655\uC131\uC758 \uACB0\uACC4\uB97C \uBAA8\uB450 \uD574\uC81C\uD574\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uB9C8\uC655\uC744 \uCC98\uCE58\uD574 \uBCF4\uBCF4\uB9C8\uC744\uC758 \uC800\uC8FC\uB97C
      \uD480\uC5B4\uC8FC\uC2E4 \uAC70\uB77C \uBBFF\uC5B4\uC694!"
    speed: 0.03
  - text: "\uC544\uBB34 \uD3EC\uC158\uC774\uB098 \uBC8C\uCEE5 \uB9C8\uC2DC\uB294
      \uC77C\uB9CC \uC870\uC2EC\uD558\uC2DC\uACE0\uC694."
    speed: 0.03

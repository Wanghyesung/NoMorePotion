  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "06_\uC870\uC900\uACFC_\uD22C\uCC99"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uBC88\uC5D0\uB294 \uD3EC\uC158\uC73C\uB85C \uC55E\uC758 \uD45C\uC801\uC744
      \uBD80\uC234\uBCFC\uAC8C\uC694."
    speed: 0.03
  - text: "F\uB97C \uB20C\uB7EC \uD3EC\uC158\uC744 \uAEBC\uB0B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744 \uC9E7\uAC8C \uB204\uB974\uBA74
      \uBC14\uB85C \uB358\uC9C8 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC624\uB978\uCABD \uBC84\uD2BC\uC73C\uB85C \uD45C\uC801\uC744 \uC870\uC900\uD55C
      \uCC44 \uC67C\uCABD \uBC84\uD2BC\uC744 \uC9E7\uAC8C \uB20C\uB7EC \uB358\uC838\uB3C4
      \uC88B\uC544\uC694."
    speed: 0.03
  - text: "\uBE57\uB098\uAC00\uBA74 \uD3EC\uC158\uC774 \uC190\uC73C\uB85C \uB3CC\uC544\uC640\uC694.
      \uB2E4\uC2DC \uC870\uC900\uD574\uC11C \uB358\uC838\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD3EC\uC158\uC774 \uD45C\uC801\uC5D0 \uC9C1\uC811 \uB9DE\uC73C\uBA74
      \uC774\uBC88 \uC5F0\uC2B5\uC740 \uC644\uB8CC\uC608\uC694."
    speed: 0.03

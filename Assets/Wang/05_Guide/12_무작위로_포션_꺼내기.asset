  m_Name: "12_\uBB34\uC791\uC704\uB85C_\uD3EC\uC158_\uAEBC\uB0B4\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uAE09\uD560 \uB54C\uB294 F\uB85C \uD3EC\uC158\uC744 \uBE60\uB974\uAC8C
      \uAEBC\uB0BC \uC218\uB3C4 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uB2E4\uB9CC F\uB85C \uAEBC\uB0B4\uB294 \uD3EC\uC158\uC740 \uBB34\uC791\uC704\uB85C
      \uC815\uD574\uC838\uC694."
    speed: 0.03
  - text: "\uC190\uC5D0 \uB4E4\uC5C8\uB2E4\uACE0 \uBC14\uB85C \uC0AC\uC6A9\uD558\uC9C0
      \uB9D0\uACE0 \uC5B4\uB5A4 \uD3EC\uC158\uC778\uC9C0 \uBA3C\uC800 \uD655\uC778\uD558\uC138\uC694."
    speed: 0.03
  - text: "\uC6D0\uD558\uB294 \uD3EC\uC158\uC774 \uB530\uB85C \uC788\uB2E4\uBA74
      \uC778\uBCA4\uD1A0\uB9AC \uBAA9\uB85D\uC5D0\uC11C \uACE8\uB77C \uAEBC\uB0B4\uBA74
      \uB3FC\uC694."
    speed: 0.03

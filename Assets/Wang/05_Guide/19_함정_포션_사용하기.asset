MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "19_\uD568\uC815_\uD3EC\uC158_\uC0AC\uC6A9\uD558\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uBC29\uAE08 \uD655\uC778\uD55C \uD3EC\uC158\uC5D0\uB294 \uBE14\uB799\uD640
      \uD568\uC815\uC774 \uBD99\uC5B4 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC774 \uD3EC\uC158\uC744 \uB358\uC9C0\uAC70\uB098 \uB9C8\uC154\uC11C
      \uC5B4\uB5A4 \uC77C\uC774 \uC0DD\uAE30\uB294\uC9C0 \uD655\uC778\uD574\uBCFC\uAE4C\uC694?"
    speed: 0.03
  - text: "\uC67C\uCABD \uBC84\uD2BC\uC744 \uC9E7\uAC8C \uB204\uB974\uBA74 \uBC14\uB85C
      \uB358\uC9C8 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC624\uB978\uCABD \uBC84\uD2BC\uC73C\uB85C \uC870\uC900\uD55C \uCC44
      \uC67C\uCABD \uBC84\uD2BC\uC744 \uC9E7\uAC8C \uB20C\uB7EC \uB358\uC838\uB3C4
      \uC88B\uC544\uC694."
    speed: 0.03
  - text: "\uC870\uC900\uD558\uC9C0 \uC54A\uACE0 \uC67C\uCABD \uBC84\uD2BC\uC744
      \uAFB9 \uB204\uB974\uBA74 \uB9C8\uC2E4 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uB9C8\uC2DC\uBA74 \uB0B4 \uC704\uCE58\uC5D0 \uBE14\uB799\uD640\uC774
      \uC0DD\uACA8\uC694. \uBC94\uC704 \uC548\uC5D0 \uBA38\uBB34\uB974\uBA74 \uACC4\uC18D
      \uD53C\uD574\uB97C \uBC1B\uC544\uC694."
    speed: 0.03
  - text: "\uD68C\uBCF5 \uD3EC\uC158\uC774\uC5B4\uB3C4 \uD568\uC815 \uD6A8\uACFC\uAC00
      \uB354\uD574\uC9C0\uBA74 \uC704\uD5D8\uD574\uC694. \uC0AC\uC6A9\uD55C \uB4A4\uC5D0\uB294
      \uBC94\uC704\uC5D0\uC11C \uBC97\uC5B4\uB098\uC138\uC694."
    speed: 0.03

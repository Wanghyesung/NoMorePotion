  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "20_\uCCB4\uC628_\uB0AE\uCD94\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uBC88\uC5D0\uB294 \uCCB4\uC628 \uAC8C\uC774\uC9C0\uB97C \uD655\uC778\uD574\uBCFC\uAE4C\uC694?"
    speed: 0.03
  - text: "\uCD94\uC6B4 \uC9C0\uC5ED\uC5D0\uC11C\uB294 \uCCB4\uC628\uC774 \uB0B4\uB824\uAC00\uACE0,
      \uB354\uC6B4 \uC9C0\uC5ED\uC5D0\uC11C\uB294 \uC62C\uB77C\uAC00\uC694."
    speed: 0.03
  - text: "\uCCB4\uC628\uC774 30 \uC774\uD558\uAC00 \uB418\uBA74 \uCD94\uC704, 70
      \uC774\uC0C1\uC774\uBA74 \uB354\uC704 \uC0C1\uD0DC\uAC00 \uB3FC\uC694."
    speed: 0.03
  - text: "\uCD94\uC704 \uC0C1\uD0DC\uC5D0\uC11C\uB294 5\uCD08\uB9C8\uB2E4 1\uCD08
      \uB3D9\uC548 \uBAB8\uC774 \uC5BC\uC5B4\uBD99\uC5B4 \uC6C0\uC9C1\uC77C \uC218
      \uC5C6\uC5B4\uC694."
    speed: 0.03
  - text: "\uC548\uB0B4\uAC00 \uB05D\uB098\uBA74 \uCCB4\uC628\uC744 20\uC73C\uB85C
      \uB0AE\uCD9C\uAC8C\uC694. 7\uCD08 \uB3D9\uC548 \uCCB4\uC628 \uAC8C\uC774\uC9C0\uC640
      \uC5BC\uC5B4\uBD99\uB294 \uC0C1\uD0DC\uB97C \uD655\uC778\uD574\uBCF4\uC138\uC694."
    speed: 0.03

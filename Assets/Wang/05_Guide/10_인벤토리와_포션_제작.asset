  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "10_\uC778\uBCA4\uD1A0\uB9AC\uC640_\uD3EC\uC158_\uC81C\uC791"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uC81C \uBAA8\uC544\uB454 \uC7AC\uB8CC\uB85C \uC9C1\uC811 \uD3EC\uC158\uC744
      \uC870\uD569\uD574\uBCFC\uAE4C\uC694?"
    speed: 0.03
  - text: "Tab\uC744 \uB20C\uB7EC \uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uAF43\uC78E\uACFC \uCD08\uB85D \uD480\uC744 \uC870\uD569\uCC3D\uC5D0
      \uD558\uB098\uC529 \uB123\uC73C\uBA74 \uBC8C\uB5A1\uBC8C\uB5A1 \uD3EC\uC158\uC744
      \uB9CC\uB4E4 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uACF5\uC6A9 \uC778\uBCA4\uD1A0\uB9AC\uC5D0 50\uAC1C \uB4E4\uC5B4 \uC788\uB294
      \uBBF8\uC9C0\uC758 \uAC00\uB8E8\uB97C \uC591\uCABD\uC5D0 \uD558\uB098\uC529
      \uB123\uC5B4 \uC870\uD569\uD574\uBD10\uB3C4 \uC88B\uC544\uC694."
    speed: 0.03
  - text: "\uACB0\uACFC \uD3EC\uC158\uC5D0 \uCEE4\uC11C\uB97C \uC62C\uB824 \uC5B4\uB5A4
      \uD6A8\uACFC\uC778\uC9C0 \uD655\uC778\uD574\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD3EC\uC158 \uC870\uD569\uC740 \uC2E4\uD328\uD560 \uC218\uB3C4 \uC788\uC5B4\uC694.
      \uAE30\uB300\uD55C \uD6A8\uACFC\uC640 \uB2E4\uB978 \uD568\uC815 \uD3EC\uC158\uC774
      \uB9CC\uB4E4\uC5B4\uC9C8 \uC218 \uC788\uC8E0."
    speed: 0.03
  - text: "\uC11E\uAE30 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uD55C \uBC88 \uC870\uD569\uD574\uBCF4\uC138\uC694.
      \uC131\uACF5\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC774\uBC88 \uC5F0\uC2B5\uC740
      \uC644\uB8CC\uC608\uC694."
    speed: 0.03

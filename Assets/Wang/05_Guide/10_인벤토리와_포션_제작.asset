  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "10_\uC778\uBCA4\uD1A0\uB9AC\uC640_\uD3EC\uC158_\uC81C\uC791"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uC81C \uBAA8\uC544\uB454 \uC7AC\uB8CC\uB85C \uC9C1\uC811 \uD3EC\uC158\uC744
      \uC870\uD569\uD574\uBCFC\uAE4C\uC694?"
    speed: 0.03
  - text: "Tab\uC744 \uB20C\uB7EC \uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD654\uBA74\uC5D0 \uD45C\uC2DC\uB418\uB294 \uC548\uB0B4\uC5D0 \uB530\uB77C
      \uBBF8\uC9C0\uC758 \uAC00\uB8E8\uB97C \uC6B0\uD074\uB9AD\uD558\uACE0, \uC870\uD569
      \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC870\uD569 \uACB0\uACFC\uAC00 \uD568\uC815 \uD3EC\uC158\uC774\uC5B4\uB3C4
      \uC81C\uC791 \uC5F0\uC2B5\uC740 \uC644\uB8CC\uB3FC\uC694."
    speed: 0.03

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "12_F\uC640_\uD035\uC2AC\uB86F_\uC0AC\uC6A9"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uD3EC\uC158\uC744 \uAEBC\uB0B4\uB294 \uB450 \uAC00\uC9C0 \uBC29\uBC95\uC744
      \uAE30\uC5B5\uD574\uB450\uC138\uC694."
    speed: 0.03
  - text: "F\uB97C \uB204\uB974\uBA74 \uD3EC\uC158\uC744 \uBB34\uC791\uC704\uB85C
      \uAEBC\uB0B4\uC694."
    speed: 0.03
  - text: "\uC6D0\uD558\uB294 \uD3EC\uC158\uC744 \uAEBC\uB0B4\uB824\uBA74 \uADF8
      \uD3EC\uC158\uC744 \uB123\uC5B4\uB454 \uD035\uC2AC\uB86F\uC758 \uC22B\uC790
      \uD0A4\uB97C \uB204\uB974\uC138\uC694."
    speed: 0.03
  - text: "\uC774\uBC88\uC5D0 \uC815\uD55C \uD68C\uBCF5 \uD3EC\uC158\uC740 3\uBC88,
      \uBC8C\uBAA9 \uD3EC\uC158\uC740 4\uBC88\uC774\uC5D0\uC694."
    speed: 0.03
  - text: "\uAEBC\uB0B8 \uD3EC\uC158\uC744 \uC0AC\uC6A9\uD588\uB2E4\uBA74 \uC778\uBCA4\uD1A0\uB9AC\uC5D0\uC11C
      \uD574\uB2F9 \uCE78\uC5D0 \uD3EC\uC158\uC744 \uB2E4\uC2DC \uCC44\uC6CC\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uC5B4\uB5A4 \uD3EC\uC158\uC778\uC9C0 \uD5F7\uAC08\uB9B4 \uB54C\uB294
      \uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uACE0 \uCEE4\uC11C\uB97C \uC62C\uB824
      \uD6A8\uACFC\uB97C \uD655\uC778\uD558\uC138\uC694."
    speed: 0.03

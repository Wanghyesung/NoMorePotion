  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "11_\uACF5\uC6A9_\uBCF4\uAD00\uD568"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uACF5\uC6A9 \uC778\uBCA4\uD1A0\uB9AC\uB294 \uB3D9\uB8CC\uB4E4\uACFC \uD568\uAED8
      \uC4F0\uB294 \uBCF4\uAD00\uD568\uC774\uC5D0\uC694."
    speed: 0.03
  - text: "Tab\uC744 \uB20C\uB7EC \uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uC5B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uAC1C\uC778 \uC778\uBCA4\uD1A0\uB9AC\uC758 \uD3EC\uC158\uC744 \uD074\uB9AD\uD574\uC11C
      \uACF5\uC6A9 \uC778\uBCA4\uD1A0\uB9AC\uB85C \uC62E\uACA8\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC774\uBC88\uC5D0\uB294 \uACF5\uC6A9 \uC778\uBCA4\uD1A0\uB9AC\uC758 \uD3EC\uC158\uC744
      \uD074\uB9AD\uD574\uC11C \uAC1C\uC778 \uC778\uBCA4\uD1A0\uB9AC\uB85C \uAC00\uC838\uC640\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uAC1C\uC778 \uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uAC00\uC838\uC628 \uD3EC\uC158\uC740
      \uD574\uB2F9 \uD035\uC2AC\uB86F \uBC88\uD638\uB85C \uAEBC\uB0BC \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uD3EC\uC158\uC744 \uD55C \uBC88 \uB123\uACE0, \uD55C \uBC88 \uAEBC\uB0B4\uBCF4\uBA74
      \uC774\uBC88 \uC5F0\uC2B5\uC740 \uC644\uB8CC\uC608\uC694."
    speed: 0.03

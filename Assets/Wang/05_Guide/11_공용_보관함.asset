  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "11_\uACF5\uC6A9_\uBCF4\uAD00\uD568"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uB9CC\uB4E0 \uD3EC\uC158\uC740 \uACF5\uC6A9 \uBCF4\uAD00\uD568\uC5D0
      \uB123\uC5B4 \uB3D9\uB8CC\uC640 \uD568\uAED8 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uD63C\uC790 \uB2E4 \uB4E4\uACE0 \uC788\uB2E4\uAC00 \uC815\uC791 \uD544\uC694\uD55C
      \uB3D9\uB8CC\uAC00 \uBE48\uC190\uC73C\uB85C \uC2F8\uC6B0\uAC8C \uB418\uBA74
      \uACE4\uB780\uD558\uACA0\uC8E0?"
    speed: 0.03
  - text: "\uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uC5B4 \uB9CC\uB4E0 \uD3EC\uC158\uC744
      \uACF5\uC6A9 \uBCF4\uAD00\uD568\uC5D0 \uB123\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uBCF4\uAD00\uD55C \uD3EC\uC158\uC5D0 \uCEE4\uC11C\uB97C \uC62C\uB824
      \uC5B4\uB5A4 \uD6A8\uACFC\uAC00 \uC788\uB294\uC9C0 \uD655\uC778\uD574\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD544\uC694\uD55C \uD3EC\uC158\uC744 \uAC1C\uC778 \uC778\uBCA4\uD1A0\uB9AC\uB85C
      \uAC00\uC838\uC640 \uD035\uC2AC\uB86F\uC5D0 \uB123\uC5B4\uB450\uBA74 \uB2E4\uC2DC
      \uAEBC\uB0B4 \uC4F8 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03

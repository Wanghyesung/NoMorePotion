  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "18_\uD754\uB4E4\uC5B4\uC11C_\uD655\uC778\uD558\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uADF8\uB7F4\uB4EF\uD55C \uD3EC\uC158\uC774\uB77C\uACE0 \uC804\uBD80 \uBBFF\uC5B4\uC11C\uB294
      \uC548 \uB3FC\uC694."
    speed: 0.03
  - text: "\uC774\uBC88\uC5D0\uB294 1\uBC88 \uD035\uC2AC\uB86F\uC5D0 \uD568\uC815
      \uD3EC\uC158\uC744 \uC900\uBE44\uD574\uB4DC\uB9B4\uAC8C\uC694."
    speed: 0.03
  - text: "\uC22B\uC790 1\uC744 \uB20C\uB7EC \uD3EC\uC158\uC744 \uAEBC\uB0B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "R\uC744 \uB204\uB978 \uCC44\uB85C \uC190\uC5D0 \uB4E0 \uD3EC\uC158\uC744
      \uD754\uB4E4\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD655\uC778\uCC3D\uC5D0\uC11C \uD3EC\uC158 \uC774\uB984 \uC544\uB798\uC5D0
      \uBD99\uC740 \uD568\uC815 \uD0A4\uC6CC\uB4DC\uB97C \uC77D\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD655\uC778\uC744 \uB9C8\uCCE4\uB2E4\uBA74 R\uC744 \uB193\uC544\uC8FC\uC138\uC694."
    speed: 0.03

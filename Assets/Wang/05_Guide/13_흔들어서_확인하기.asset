  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "13_\uD754\uB4E4\uC5B4\uC11C_\uD655\uC778\uD558\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uADF8\uB7F4\uB4EF\uD55C \uD3EC\uC158\uC774\uB77C\uACE0 \uC804\uBD80 \uBBFF\uC5B4\uC11C\uB294
      \uC548 \uB3FC\uC694."
    speed: 0.03
  - text: "\uAC89\uBCF4\uAE30\uC640 \uB2E4\uB978 \uD6A8\uACFC\uB97C \uAC00\uC9C4
      \uD568\uC815 \uD3EC\uC158\uC774 \uC11E\uC5EC \uC788\uC744 \uC218 \uC788\uAC70\uB4E0\uC694."
    speed: 0.03
  - text: "\uC778\uBCA4\uD1A0\uB9AC\uAC00 \uC5F4\uB824 \uC788\uB2E4\uBA74 Tab\uC73C\uB85C
      \uB2EB\uACE0, F\uB098 \uD035\uC2AC\uB86F\uC73C\uB85C \uD3EC\uC158\uC744 \uC190\uC5D0
      \uB4E4\uC5B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "R\uC744 \uB20C\uB7EC \uC190\uC5D0 \uB4E0 \uD3EC\uC158\uC744 \uD754\uB4E4\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD655\uC778\uCC3D\uC5D0 \uB098\uD0C0\uB09C \uB0B4\uC6A9\uC744 \uC77D\uACE0
      \uC0AC\uC6A9\uD560\uC9C0 \uD310\uB2E8\uD574\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uBCF4\uBCF4\uB9C8\uC744\uC5D0\uC11C\uB294 \uD655\uC778\uD558\uB294 \uC0AC\uB78C\uC774
      \uC624\uB798 \uC0B4\uC544\uB0A8\uB294\uB2F5\uB2C8\uB2E4."
    speed: 0.03

  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "16_\uD3EC\uC158\uC73C\uB85C_\uC790\uC6D0_\uCC44\uC9D1"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC791\uC740 \uC7AC\uB8CC\uB294 \uC8FC\uC6B8 \uC218 \uC788\uC9C0\uB9CC,
      \uB098\uBB34\uB294 \uD3EC\uC158\uC73C\uB85C \uBD80\uC234\uC57C \uD574\uC694."
    speed: 0.03
  - text: "4\uBC88 \uD035\uC2AC\uB86F\uC5D0 \uBC8C\uBAA9\uC6A9 \uC11C\uAC71\uC11C\uAC71
      \uD3EC\uC158\uC744 \uC900\uBE44\uD574\uB4DC\uB838\uC5B4\uC694. \uC22B\uC790
      4\uB97C \uB20C\uB7EC \uAEBC\uB0B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC73C\uB85C \uC870\uC900\uD558\uACE0
      \uC67C\uCABD \uBC84\uD2BC\uC744 \uC9E7\uAC8C \uB20C\uB7EC \uD45C\uC2DC\uB41C
      \uB098\uBB34\uC5D0 \uB358\uC838\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uB098\uBB34\uAC00 \uBD80\uC11C\uC9C0\uBA74 \uC7AC\uB8CC \uC8FC\uBA38\uB2C8\uAC00
      \uB5A8\uC5B4\uC838\uC694. \uAC00\uAE4C\uC774\uC5D0\uC11C E\uB85C \uC8FC\uC6B8
      \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC774\uBC88\uC5D0\uB294 \uD45C\uC2DC\uB41C \uB098\uBB34\uB97C \uBD80\uC234\uBCF4\uC138\uC694!"
    speed: 0.03

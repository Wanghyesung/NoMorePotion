  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "\uCD94\uAC00_C_\uCD94\uC6B4_\uC9C0\uC5ED\uC5D0_\uCC98\uC74C_\uB4E4\uC5B4\uAC08_\uB54C"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC55E\uC73C\uB85C\uB294 \uCD94\uC6B4 \uC9C0\uC5ED\uC774 \uC774\uC5B4\uC838\uC694."
    speed: 0.03
  - text: "\uC900\uBE44 \uC5C6\uC774 \uC624\uB798 \uBA38\uBB3C\uBA74 \uCCB4\uC628\uC774
      \uB0B4\uB824\uAC00\uC694."
    speed: 0.03
  - text: "\uBAB8\uC744 \uB530\uB73B\uD558\uAC8C \uD574\uC8FC\uB294 \uD3EC\uC158\uC744
      \uC900\uBE44\uD558\uACE0 \uB4E4\uC5B4\uAC00\uB294 \uAC8C \uC88B\uACA0\uC8E0?"
    speed: 0.03
  - text: "\uB530\uB543 \uD3EC\uC158\uC744 \uC0AC\uC6A9\uD55C \uB4A4 \uCCB4\uC628
      \uAC8C\uC774\uC9C0\uB97C \uD655\uC778\uD574\uBCF4\uC138\uC694."
    speed: 0.03

  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "06_\uD3EC\uC158_\uB9C8\uC2DC\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uD3EC\uC158\uC740 \uC9C1\uC811 \uB9C8\uC154\uC11C \uC790\uC2E0\uC5D0\uAC8C
      \uC0AC\uC6A9\uD560 \uC218\uB3C4 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC774\uBC88\uC5D0\uB294 \uCCB4\uB825\uC744 \uD68C\uBCF5\uD558\uB294 \uD3EC\uC158\uC744
      \uC900\uBE44\uD588\uC5B4\uC694."
    speed: 0.03
  - text: "\uD3EC\uC158\uC744 \uAEBC\uB0B8 \uB4A4 \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD
      \uBC84\uD2BC\uC5D0\uC11C \uC190\uC744 \uB5BC\uC5B4 \uC870\uC900\uC744 \uD480\uC5B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744 \uAE38\uAC8C \uB20C\uB7EC
      \uD3EC\uC158\uC744 \uB9C8\uC154\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uB9C8\uC2E0 \uB4A4\uC5D0\uB294 \uCCB4\uB825 \uAC8C\uC774\uC9C0\uAC00
      \uC5B4\uB5BB\uAC8C \uBC14\uB00C\uB294\uC9C0\uB3C4 \uD655\uC778\uD574\uBCF4\uC138\uC694."
    speed: 0.03

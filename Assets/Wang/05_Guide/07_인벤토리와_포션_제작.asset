MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "07_\uC778\uBCA4\uD1A0\uB9AC\uC640_\uD3EC\uC158_\uC81C\uC791"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "Tab\uC744 \uB20C\uB7EC \uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uBAA8\uC740 \uC7AC\uB8CC\uB97C \uC870\uD569\uCC3D\uC5D0 \uB123\uACE0
      \uC5B4\uB5A4 \uD3EC\uC158\uC774 \uB098\uC624\uB294\uC9C0 \uD655\uC778\uD574\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uACB0\uACFC \uD3EC\uC158\uC5D0 \uB9C8\uC6B0\uC2A4 \uCEE4\uC11C\uB97C
      \uC62C\uB9AC\uBA74 \uC5B4\uB5A4 \uD6A8\uACFC\uAC00 \uC788\uB294\uC9C0 \uC77D\uC744
      \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC774\uB984\uB9CC \uBCF4\uACE0 \uACE0\uB974\uC9C0 \uB9D0\uACE0 \uD6A8\uACFC\uB97C
      \uD655\uC778\uD55C \uB4A4 \uC11E\uAE30 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uC774\uBC88\uC5D0\uB294 \uCCB4\uB825\uC744 \uD68C\uBCF5\uD558\uB294 \uD3EC\uC158\uACFC
      \uB098\uBB34\uB97C \uBCA8 \uC218 \uC788\uB294 \uD3EC\uC158\uC744 \uAC01\uAC01
      \uB9CC\uB4E4\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uB9CC\uB4E0 \uD3EC\uC158\uC5D0\uB3C4 \uCEE4\uC11C\uB97C \uC62C\uB824
      \uD6A8\uACFC\uB97C \uB2E4\uC2DC \uD655\uC778\uD574\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uAC1C\uC778 \uC778\uBCA4\uD1A0\uB9AC\uC758 \uBC88\uD638\uAC00 \uBD99\uC740
      \uCE78\uC740 \uD035\uC2AC\uB86F\uACFC \uC5F0\uACB0\uB418\uC5B4 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uD68C\uBCF5 \uD3EC\uC158\uC740 3\uBC88 \uCE78\uC5D0, \uBC8C\uBAA9 \uD3EC\uC158\uC740
      4\uBC88 \uCE78\uC5D0 \uB123\uC5B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "Tab\uC744 \uB20C\uB7EC \uC778\uBCA4\uD1A0\uB9AC\uB97C \uB2EB\uC73C\uBA74
      \uC22B\uC790 \uD0A4\uB85C \uD574\uB2F9 \uCE78\uC758 \uD3EC\uC158\uC744 \uAEBC\uB0BC
      \uC218 \uC788\uC5B4\uC694."
    speed: 0.03

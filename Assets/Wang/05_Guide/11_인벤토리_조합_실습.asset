  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "1. \uC7AC\uB8CC \uC2AC\uB86F\uC744 \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD\uC73C\uB85C
      \uD074\uB9AD\uD574 \uCCAB \uBC88\uC9F8 \uC7AC\uB8CC\uB97C \uB123\uC5B4\uC8FC\uC138\uC694."
    speed: 0
  - text: "2. \uC7AC\uB8CC \uC2AC\uB86F\uC744 \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD\uC73C\uB85C
      \uD074\uB9AD\uD574 \uB450 \uBC88\uC9F8 \uC7AC\uB8CC\uB97C \uB123\uC5B4\uC8FC\uC138\uC694.
      \uAC19\uC740 \uC7AC\uB8CC\uB3C4 \uB123\uC744 \uC218 \uC788\uC5B4\uC694."
    speed: 0
  - text: "3. [\uC870\uD569] \uBC84\uD2BC\uC744 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD\uC73C\uB85C
      \uD074\uB9AD\uD574 \uD3EC\uC158\uC744 \uB9CC\uB4E4\uC5B4\uBCF4\uC138\uC694."
    speed: 0
  - text: "\uD3EC\uC158 \uC81C\uC791 \uC644\uB8CC! 1\uCD08 \uB4A4 \uC778\uBCA4\uD1A0\uB9AC\uAC00

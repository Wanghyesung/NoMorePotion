  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "01_\uBCF4\uBCF4\uB9C8\uC744\uC5D0_\uC624\uC2E0_\uAC83\uC744_\uD658\uC601\uD569\uB2C8\uB2E4"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uBCF4\uBCF4\uB9C8\uC744\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4!"
    speed: 0.03
  - text: "\uC774\uACF3\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uD589\uB3D9\uC774 \uC870\uAE08
      \uC55E\uC11C\uB294 \uC0AC\uB78C\uB4E4\uC774 \uBAA8\uC5EC \uC0AC\uB294 \uB9C8\uC744\uC774\uC5D0\uC694."
    speed: 0.03
  - text: "\uB9C8\uC655\uC758 \uC800\uC8FC\uAC00 \uB0B4\uB824\uC9C4 \uB4A4\uB85C\uB294
      \uBC24\uB9C8\uB2E4 \uBAAC\uC2A4\uD130\uAE4C\uC9C0 \uCC3E\uC544\uC624\uACE0
      \uC788\uC8E0."
    speed: 0.03
  - text: "\uC800\uC8FC\uB97C \uD480\uB824\uBA74 \uAC01 \uC9C0\uC5ED\uC758 \uBCF4\uC2A4\uB97C
      \uC4F0\uB7EC\uB728\uB824 \uB9C8\uC655\uC131\uC758 \uACB0\uACC4\uB97C \uD574\uC81C\uD574\uC57C
      \uD574\uC694."
    speed: 0.03
  - text: "\uADF8\uB9AC\uACE0 \uB9C8\uC655\uC744 \uCC98\uCE58\uD558\uBA74 \uC6B0\uB9AC
      \uB9C8\uC744\uB3C4 \uD3C9\uD654\uB97C \uB418\uCC3E\uC744 \uC218 \uC788\uC744
      \uAC70\uC608\uC694."
    speed: 0.03
  - text: "\uBD80\uB514 \uBCF4\uBCF4\uB9C8\uC744\uC758 \uC800\uC8FC\uB97C \uD480\uC5B4\uC8FC\uC138\uC694!"
    speed: 0.03
  - text: "\uADF8\uB7EC\uB824\uBA74 \uBA3C\uC800 \uC774\uACF3\uC5D0\uC11C \uC0B4\uC544\uB0A8\uB294
      \uBC29\uBC95\uBD80\uD130 \uC54C\uC544\uC57C\uACA0\uC8E0?"
    speed: 0.03

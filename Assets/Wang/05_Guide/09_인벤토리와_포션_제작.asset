  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "09_\uC778\uBCA4\uD1A0\uB9AC\uC640_\uD3EC\uC158_\uC81C\uC791"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uC81C \uC9C1\uC811 \uD3EC\uC158\uC744 \uB9CC\uB4E4\uC5B4\uBCFC
      \uCC28\uB840\uC608\uC694."
    speed: 0.03
  - text: "Tab\uC744 \uB20C\uB7EC \uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uC5B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uBC29\uAE08 \uC8FC\uC6B4 \uAF43\uC78E\uACFC \uD480\uC744 \uC870\uD569\uCC3D\uC5D0
      \uD558\uB098\uC529 \uB123\uC5B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uACB0\uACFC\uB97C \uD655\uC778\uD558\uACE0 \uC11E\uAE30 \uBC84\uD2BC\uC744
      \uB204\uB974\uBA74 \uBC8C\uB5A1\uBC8C\uB5A1 \uD3EC\uC158\uC744 \uB9CC\uB4E4
      \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC774\uBC88\uC5D0\uB294 \uC774\uB984\uCC98\uB7FC \uAE30\uC6B4\uC774 \uB098\uB294
      \uD3EC\uC158\uC774 \uB098\uC62C \uAC70\uC608\uC694!"
    speed: 0.03

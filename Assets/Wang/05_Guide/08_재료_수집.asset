  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "08_\uC7AC\uB8CC_\uC218\uC9D1"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uD3EC\uC158\uC744 \uB2E4 \uC37C\uB2E4\uACE0 \uBE48 \uBCD1\uC73C\uB85C
      \uC2F8\uC6B8 \uC218\uB294 \uC5C6\uACA0\uC8E0?"
    speed: 0.03
  - text: "\uC0C8 \uD3EC\uC158\uC744 \uB9CC\uB4E4\uB824\uBA74 \uC7AC\uB8CC\uB97C
      \uBAA8\uC544\uC57C \uD574\uC694."
    speed: 0.03
  - text: "\uAC00\uAE4C\uC6B4 \uC7AC\uB8CC\uC5D0 \uB2E4\uAC00\uAC00 E\uB97C \uB204\uB974\uBA74
      \uC8FC\uC6B8 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC55E\uC5D0 \uD45C\uC2DC\uB41C \uAF43\uC78E\uACFC \uD480\uC744 \uD558\uB098\uC529
      \uC8FC\uC6CC\uBCF4\uC138\uC694."
    speed: 0.03

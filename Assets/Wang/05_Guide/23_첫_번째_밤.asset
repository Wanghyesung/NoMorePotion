  texts:
  - text: "\uBC8C\uC368 \uD574\uAC00 \uC9C0\uACE0 \uC788\uC5B4\uC694!"
    speed: 0.03
  - text: "\uC774\uC81C \uBC30\uC6B4 \uAC83\uC744 \uC368\uBCFC \uC2DC\uAC04\uC774\uB124\uC694."
    speed: 0.03
  - text: "\uBC24\uC5D0\uB294 \uBAAC\uC2A4\uD130\uB4E4\uC774 \uC218\uC815\uAD6C\uC2AC\uC744
      \uD5A5\uD574 \uBAB0\uB824\uC640\uC694."
    speed: 0.03
  - text: "\uD3EC\uC158\uC744 \uC900\uBE44\uD558\uACE0 \uC218\uC815\uAD6C\uC2AC \uADFC\uCC98\uB85C
      \uC774\uB3D9\uD574\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uC218\uC815\uAD6C\uC2AC\uC5D0 \uB2E4\uAC00\uC624\uB294 \uBAAC\uC2A4\uD130\uB4E4\uC744

  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "\uCD94\uAC00_B_\uC815\uC2E0\uB825\uC774_\uB0AE\uC544\uC84C\uC744_\uB54C"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uACF3\uC740 \uC5B4\uB450\uC6CC\uC11C \uC624\uB798 \uBA38\uBB3C\uBA74
      \uC815\uC2E0\uB825\uC774 \uC904\uC5B4\uB4E4\uC5B4\uC694."
    speed: 0.03
  - text: "\uC815\uC2E0\uB825\uC774 \uB0AE\uC544\uC9C0\uBA74 \uC2DC\uC57C\uAC00 \uB098\uBE60\uC9C0\uACE0
      \uD3EC\uC158 \uC81C\uC791\uB3C4 \uBD88\uC548\uC815\uD574\uC9C8 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC6B0\uC120 \uD45C\uC2DC\uB41C \uBC1D\uC740 \uACF3\uC73C\uB85C \uB3CC\uC544\uAC00\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD544\uC694\uD558\uB2E4\uBA74 \uC815\uC2E0\uB825\uC744 \uD68C\uBCF5\uD558\uB294
      \uD3EC\uC158\uB3C4 \uC900\uBE44\uD574\uC8FC\uC138\uC694."
    speed: 0.03

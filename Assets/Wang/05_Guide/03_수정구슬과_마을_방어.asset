  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "03_\uC218\uC815\uAD6C\uC2AC\uACFC_\uB9C8\uC744_\uBC29\uC5B4"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC800\uAE30 \uBCF4\uC774\uB294 \uC218\uC815\uAD6C\uC2AC\uC774 \uBAAC\uC2A4\uD130\uB4E4\uC774
      \uB178\uB9AC\uB294 \uBAA9\uD45C\uC608\uC694."
    speed: 0.03
  - text: "\uBC24\uC774 \uB418\uBA74 \uBAAC\uC2A4\uD130\uB4E4\uC774 \uB9C8\uC744\uB85C
      \uBAB0\uB824\uC640 \uC218\uC815\uAD6C\uC2AC\uC744 \uACF5\uACA9\uD558\uC8E0."
    speed: 0.03
  - text: "\uC218\uC815\uAD6C\uC2AC\uC774 \uD30C\uAD34\uB418\uBA74 \uB354\uB294 \uBC84\uD2F8
      \uC218 \uC5C6\uC5B4\uC694."
    speed: 0.03
  - text: "\uB0AE\uC5D0\uB294 \uBC16\uC5D0\uC11C \uC900\uBE44\uD558\uACE0 \uBC24\uC5D0\uB294
      \uB3CC\uC544\uC640 \uC218\uC815\uAD6C\uC2AC\uC744 \uC9C0\uCF1C\uC8FC\uC138\uC694."
    speed: 0.03

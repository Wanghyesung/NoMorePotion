  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "\uCD94\uAC00_D_\uB354\uC6B4_\uC9C0\uC5ED\uC5D0_\uCC98\uC74C_\uB4E4\uC5B4\uAC08_\uB54C"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uCABD\uC740 \uAC00\uB9CC\uD788 \uC788\uC5B4\uB3C4 \uBAB8\uC774
      \uB728\uAC70\uC6CC\uC9C0\uB294 \uACF3\uC774\uC5D0\uC694."
    speed: 0.03
  - text: "\uB354 \uAE4A\uC774 \uB4E4\uC5B4\uAC00\uAE30 \uC804\uC5D0 \uCCB4\uC628\uACFC
      \uC218\uBD84\uC744 \uD655\uC778\uD574\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uB354\uC704\uB97C \uACAC\uB51C \uC900\uBE44\uAC00 \uBD80\uC871\uD558\uB2E4\uBA74
      \uC548\uC804\uD55C \uACF3\uC73C\uB85C \uB3CC\uC544\uAC00 \uD3EC\uC158\uBD80\uD130
      \uCC59\uACA8\uC8FC\uC138\uC694."
    speed: 0.03

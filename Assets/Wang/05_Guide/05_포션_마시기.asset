  m_Name: "05_\uD3EC\uC158_\uB9C8\uC2DC\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774\uBC88\uC5D0\uB294 \uD3EC\uC158\uC744 \uB9C8\uC154\uBCFC\uAE4C\uC694?"
    speed: 0.03
  - text: "\uC190\uC5D0 \uD3EC\uC158\uC774 \uC5C6\uB2E4\uBA74 F\uB97C \uB20C\uB7EC
      \uAEBC\uB0B4\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uC870\uC900\uD558\uC9C0 \uC54A\uC740 \uC0C1\uD0DC\uC5D0\uC11C \uB9C8\uC6B0\uC2A4
      \uC67C\uCABD \uBC84\uD2BC\uC744 \uAFB9 \uB20C\uB7EC\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "\uD3EC\uC158\uC744 \uB05D\uAE4C\uC9C0 \uB9C8\uC2DC\uBA74 \uB2E4\uC74C
      \uC5F0\uC2B5\uC73C\uB85C \uB118\uC5B4\uAC08\uAC8C\uC694."
    speed: 0.03

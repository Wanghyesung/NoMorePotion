  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "04_\uD3EC\uC158_\uAEBC\uB0B4\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uC774 \uB9C8\uC744\uC5D0\uC11C\uB294 \uC2F8\uC6B8 \uB54C\uB3C4 \uC0B4\uC544\uB0A8\uC744
      \uB54C\uB3C4 \uD3EC\uC158\uC774 \uD544\uC694\uD574\uC694."
    speed: 0.03
  - text: "\uC6B0\uC120 F\uB97C \uB20C\uB7EC \uD3EC\uC158\uC744 \uAEBC\uB0B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "F\uB85C \uAEBC\uB0B4\uB294 \uD3EC\uC158\uC740 \uBB34\uC791\uC704\uB85C
      \uC815\uD574\uC838\uC694."
    speed: 0.03
  - text: "\uD654\uBA74 \uC544\uB798\uC5D0\uC11C \uC9C0\uAE08 \uC5B4\uB290 \uC190\uC5D0
      \uD3EC\uC158\uC744 \uB4E4\uACE0 \uC788\uB294\uC9C0 \uD655\uC778\uD574\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC6D0\uD558\uB294 \uD3EC\uC158\uC744 \uACE8\uB77C \uAEBC\uB0B4\uB294
      \uBC29\uBC95\uC740 \uC7A0\uC2DC \uB4A4\uC5D0 \uC54C\uB824\uB4DC\uB9B4\uAC8C\uC694."
    speed: 0.03

  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "07_\uC591\uC190\uACFC_\uC190_\uBC14\uAFB8\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uD3EC\uC158\uC740 \uC591\uC190\uC5D0 \uD558\uB098\uC529 \uB4E4 \uC218
      \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC190\uC774 \uBE44\uC5C8\uB2E4\uBA74 F\uB098 \uD035\uC2AC\uB86F\uC73C\uB85C
      \uD3EC\uC158\uC744 \uAEBC\uB0B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "Q\uB97C \uB204\uB974\uBA74 \uC0AC\uC6A9\uD560 \uC190\uC774 \uBC14\uB00C\uC5B4\uC694."
    speed: 0.03
  - text: "\uD654\uBA74 \uC544\uB798\uC758 \uC190 \uC120\uD0DD \uD45C\uC2DC\uB97C
      \uBCF4\uBA74\uC11C Q\uB97C \uB20C\uB7EC\uBCF4\uC138\uC694."
    speed: 0.03

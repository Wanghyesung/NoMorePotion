  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "07_\uC591\uC190\uACFC_\uC190_\uBC14\uAFB8\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uD3EC\uC158\uC740 \uC591\uC190\uC5D0 \uD558\uB098\uC529 \uB4E4 \uC218
      \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "\uC591\uC190\uC5D0 \uC11C\uB85C \uB2E4\uB978 \uD3EC\uC158\uC774 \uC788\uB2E4\uBA74
      \uC0AC\uC6A9\uD560 \uC190\uC744 \uD655\uC778\uD574\uC57C\uACA0\uC8E0?"
    speed: 0.03
  - text: "Q\uB97C \uB204\uB974\uBA74 \uC0AC\uC6A9\uD560 \uC190\uC774 \uBC14\uB00C\uC5B4\uC694."
    speed: 0.03
  - text: "\uD654\uBA74 \uC544\uB798\uC5D0\uC11C \uC120\uD0DD \uD45C\uC2DC\uAC00
      \uC5B4\uB290 \uC190\uC5D0 \uC788\uB294\uC9C0 \uC0B4\uD3B4\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC774\uBC88\uC5D0\uB294 \uD68C\uBCF5 \uD3EC\uC158\uC774 \uC788\uB294
      \uC190\uC744 \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
    speed: 0.03

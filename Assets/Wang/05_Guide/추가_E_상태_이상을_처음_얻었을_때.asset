  m_Script: {fileID: 11500000, guid: f126dadac6ede0b4eaa85f1bcc61045b, type: 3}
  m_Name: "\uCD94\uAC00_E_\uC0C1\uD0DC_\uC774\uC0C1\uC744_\uCC98\uC74C_\uC5BB\uC5C8\uC744_\uB54C"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uD3C9\uC18C\uC640 \uBAB8 \uC0C1\uD0DC\uAC00 \uC870\uAE08 \uB2EC\uB77C\uC9C4
      \uAC83 \uAC19\uB124\uC694."
    speed: 0.03
  - text: "\uD654\uBA74\uC5D0 \uB098\uD0C0\uB09C \uC0C1\uD0DC \uC544\uC774\uCF58\uC5D0\uC11C
      \uC6D0\uC778\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
  - text: "Alt\uB97C \uB204\uB978 \uCC44 \uC544\uC774\uCF58 \uC704\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C
      \uC62C\uB824\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uD6A8\uACFC\uC640 \uD574\uC81C \uBC29\uBC95\uC744 \uC77D\uACE0 \uD544\uC694\uD55C
      \uD3EC\uC158\uC744 \uC900\uBE44\uD574\uC8FC\uC138\uC694."
    speed: 0.03
  - text: "Alt\uB97C \uB193\uC73C\uBA74 \uB2E4\uC2DC \uB9C8\uC6B0\uC2A4\uB85C \uC8FC\uC704\uB97C
      \uB458\uB7EC\uBCFC \uC218 \uC788\uC5B4\uC694."
    speed: 0.03

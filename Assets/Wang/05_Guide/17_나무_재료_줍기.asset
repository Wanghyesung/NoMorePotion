  m_Name: "17_\uB098\uBB34_\uC7AC\uB8CC_\uC90D\uAE30"
  m_EditorClassIdentifier: Assembly-CSharp::SOEventText
  texts:
  - text: "\uB098\uBB34\uB97C \uBD80\uC218\uBA74 \uC7AC\uB8CC \uC8FC\uBA38\uB2C8\uAC00
      \uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC838\uC694."
    speed: 0.03
  - text: "\uB5A8\uC5B4\uC9C4 \uB098\uBB34 \uC7AC\uB8CC \uAC00\uAE4C\uC774 \uC774\uB3D9\uD55C
      \uB4A4 E\uD0A4\uB85C \uC8FC\uC6CC\uBCF4\uC138\uC694."
    speed: 0.03
  - text: "\uC8FC\uC6B4 \uC7AC\uB8CC\uB294 \uACF5\uC6A9 \uC778\uBCA4\uD1A0\uB9AC\uC5D0
      \uB4E4\uC5B4\uAC00\uACE0, \uD3EC\uC158\uC744 \uB9CC\uB4DC\uB294 \uB370 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC5B4\uC694."
    speed: 0.03
